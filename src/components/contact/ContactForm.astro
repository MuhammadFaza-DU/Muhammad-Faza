---
import type {Locale} from "../../data/types";
import {copy} from "../../i18n";
import {contactFormConfig,contactFormCopy} from "../../data/contact-form";
import "../../styles/contact-form.css";
const {locale}=Astro.props as {locale:Locale};
const t=contactFormCopy[locale];
---
<div class="contact-direct contact-form-panel" data-motion-enter="3" data-motion-scroll>
  <h2>{t.title}</h2>
  <p class="contact-form-lead">{t.leadSentences.map((sentence,index)=><>{index>0&&" "}<span class="contact-sentence">{sentence}</span></>)}</p>
  <form action={contactFormConfig.endpoint} method="post" class="contact-message-form" data-contact-form data-contact-state="idle">
    <div class="contact-form-field">
      <label for="contact-subject">{t.subject}</label>
      <input id="contact-subject" name="subject" type="text" required maxlength={contactFormConfig.limits.subject}
        placeholder={t.subjectPlaceholder} aria-describedby="contact-subject-error" />
      <p id="contact-subject-error" class="contact-field-error" data-contact-error="subject" hidden></p>
    </div>
    <div class="contact-form-field">
      <label for="contact-email">{t.email}</label>
      <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength={contactFormConfig.limits.email}
        placeholder={t.emailPlaceholder} aria-describedby="contact-email-error" />
      <p id="contact-email-error" class="contact-field-error" data-contact-error="email" hidden></p>
    </div>
    <div class="contact-form-field contact-form-field--message">
      <label for="contact-message">{t.message}</label>
      <textarea id="contact-message" name="message" rows="4" required maxlength={contactFormConfig.limits.message}
        placeholder={t.messagePlaceholder} aria-describedby="contact-message-error"></textarea>
      <p id="contact-message-error" class="contact-field-error" data-contact-error="message" hidden></p>
    </div>
    <button class="button contact-submit" type="submit">{t.send}</button>
    <p class="contact-form-feedback" data-contact-status role="status" aria-live="polite" aria-atomic="true"></p>
    <noscript><p class="contact-form-nojs">{t.noJs}</p></noscript>
  </form>
  <div class="contact-form-footer">
    <a class="text-link contact-resume" href="/assets/documents/Resume.pdf" target="_blank" rel="noreferrer">{copy[locale].actions.resume}</a>
  </div>
</div>
<script>import "../../client/contact-form";</script>
