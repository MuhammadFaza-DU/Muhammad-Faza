---
import type {Locale} from "../../data/types";
const {locale}=Astro.props as {locale:Locale};
const id=locale==="id";
---
<div class="opening-screen" role="status" aria-live="polite" aria-atomic="true">
  <div class="opening-content">
    <div class="opening-mark" aria-hidden="true">
      <img class="opening-mark-light" src="/media/brand/mf-black.svg" width="112" height="112" alt="" fetchpriority="high" />
      <img class="opening-mark-dark" src="/media/brand/mf-white.svg" width="112" height="112" alt="" fetchpriority="high" />
    </div>
    <p class="opening-label">{id?"Menyiapkan portfolio":"Preparing portfolio"}</p>
    <p class="opening-slow">{id?"Pemuatan lebih lama. Menyiapkan tampilan interaktif…":"Taking a little longer. Preparing the interactive experience…"}</p>
    <div class="opening-failure">
      <p>{id?"Tampilan interaktif belum berhasil dimuat. Silakan coba lagi.":"The interactive experience could not load. Please try again."}</p>
      <div class="opening-actions">
        <button type="button" class="button" data-opening-retry>{id?"Coba lagi":"Try again"}</button>
        <a class="text-link" href={`/${locale}/contact/`}>{id?"Buka kontak":"Open contact"}</a>
      </div>
    </div>
  </div>
</div>
