# Copy to .env.local and set before building. Both values below are PUBLIC:
# they are intentionally included in the browser bundle, not private API keys.
PUBLIC_PROJECT_COMMENTS_API_URL=https://your-comments-worker.example
PUBLIC_TURNSTILE_SITE_KEY=replace-with-public-turnstile-site-key

# TURNSTILE_SECRET and ABUSE_HASH_SALT belong only in Worker secret bindings
# (or services/comments/.dev.vars for local backend testing). Never put their
# values in PUBLIC_* variables, this example, src/, public/, or dist/.
